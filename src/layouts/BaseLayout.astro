---
import { Font } from "astro:assets";
import { site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

/*
 * The inline script below sets two classes on <html>:
 *  - `js`: JS is available, so entrances and reveals may hide content first;
 *  - `is-ready`: start the load choreography once the faces it uses are in
 *    (max 700ms), with a hard fallback so nothing can stay hidden.
 */
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16212b" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const ready = () => root.classList.add("is-ready");
        root.classList.add("js");
        setTimeout(ready, 1200);
        addEventListener("DOMContentLoaded", () => {
          const css = getComputedStyle(root);
          const serif = css.getPropertyValue("--font-newsreader");
          const sans = css.getPropertyValue("--font-instrument-sans");
          const faces = [`380 1em ${serif}`, `italic 360 1em ${serif}`, `500 1em ${sans}`];
          const timeout = new Promise((resolve) => setTimeout(resolve, 700));
          Promise.race([Promise.all(faces.map((f) => document.fonts.load(f))), timeout])
            .catch(() => {})
            .then(() => requestAnimationFrame(ready));
        });
      })();
    </script>
    <Font cssVariable="--font-newsreader" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-instrument-sans" preload />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
