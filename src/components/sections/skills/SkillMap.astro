---
/**
 * The skills map. Backend sits at the centre; Frontend, Data, Cloud &
 * Engineering and AI & Automation connect to it. Every line drawn between two
 * groups comes from a real link between two of their tools (data/skills.ts),
 * so the picture can't claim a relationship the data doesn't contain.
 *
 * Wide screens (80rem+): a 3×3 field with the lines drawn in an SVG overlay,
 * measured from the groups themselves. Narrower: a tree — Backend first, the other
 * groups branching off one spine.
 *
 * Every tool is a button (see scripts/explore.ts): hover, focus or tap it to
 * keep its linked tools bright, light the lines between their groups in
 * copper, and read what it is in its group's caption. Arrow keys move within
 * a group. The key ("Used in my current role") works the same way for the
 * tools marked with the copper square.
 */
import { skillGroups, toolId, toolLinks } from "@/data/skills";

interface Props {
  currentTools: Set<string>;
}

const { currentTools } = Astro.props;

const links = new Map<string, string[]>();
for (const [a, b] of toolLinks) {
  links.set(a, [...(links.get(a) ?? []), b]);
  links.set(b, [...(links.get(b) ?? []), a]);
}

const groupOf = new Map(skillGroups.flatMap((g) => g.tools.map((t) => [t.name, g.id] as const)));
const groupName = new Map(skillGroups.map((g) => [g.id, g.name] as const));

// Group-level connections, derived from tool links that cross groups.
const groupEdges = new Set<string>();
for (const [a, b] of toolLinks) {
  const ga = groupOf.get(a);
  const gb = groupOf.get(b);
  if (ga && gb && ga !== gb) groupEdges.add([ga, gb].sort().join(" "));
}

const current = [...currentTools].filter((name) => groupOf.has(name));
const core = skillGroups.find((g) => g.id === "backend")!;
const satellites = skillGroups.filter((g) => g.id !== "backend");
---

<div class="map" data-explore-map data-edges={[...groupEdges].join(",")}>
  <div class="map__key">
    <button
      type="button"
      class="map__key-node"
      data-node="current"
      data-group=""
      data-links={current.map(toolId).join(" ")}
      aria-describedby="map-key-note"
      aria-pressed="false"
    >
      <span class="map__square" aria-hidden="true"></span>
      <span class="map__key-label">Used in my current role</span>
    </button>
    <span id="map-key-note" class="map__key-note">
      The rest come from projects and ongoing learning.
    </span>
  </div>

  <div class="map__field" data-map data-inview>
    <svg class="map__lines" aria-hidden="true" data-map-lines></svg>

    {[core, ...satellites].map((group, i) => (
      <>
        {i === 1 && <div class="map__branches-start" aria-hidden="true" />}
        <div
          class:list={["group", `group--${group.id}`, { "group--core": group === core }]}
          role="group"
          aria-labelledby={`group-${group.id}`}
          data-group-block={group.id}
        >
          <h3 id={`group-${group.id}`} class="group__name label">
            {group.name}
          </h3>
          <ul class="group__tools" role="list" data-roving>
            {group.tools.map((tool) => {
              const id = toolId(tool.name);
              const isCurrent = currentTools.has(tool.name);
              const linked = links.get(tool.name) ?? [];
              const elsewhere = linked.filter((name) => groupOf.get(name) !== group.id);
              return (
                <li>
                  <button
                    type="button"
                    class="tool"
                    data-node={id}
                    data-group={group.id}
                    data-title={tool.name}
                    data-text={tool.text}
                    data-links={linked.map(toolId).join(" ")}
                    aria-describedby={`tool-${id}`}
                    aria-pressed="false"
                  >
                    <span class="tool__name font-display">{tool.name}</span>
                    {isCurrent && <span class="tool__mark" aria-hidden="true" />}
                  </button>
                  <span id={`tool-${id}`} class="sr-only">
                    {tool.text}
                    {isCurrent && " Used in my current role."}
                    {linked.length > 0 && ` Connects to ${linked.join(", ")}.`}
                    {elsewhere.length > 0 &&
                      ` That links ${group.name} with ${[...new Set(elsewhere.map((n) => groupName.get(groupOf.get(n)!)))].join(" and ")}.`}
                  </span>
                </li>
              );
            })}
          </ul>
          <p class="group__caption" data-caption={group.id} data-default={group.text}>
            {group.text}
          </p>
        </div>
      </>
    ))}
  </div>
</div>

<script>
  import { explore } from "@/scripts/explore";

  const SVG = "http://www.w3.org/2000/svg";
  const desktop = matchMedia("(min-width: 80rem)");

  document.querySelectorAll<HTMLElement>("[data-explore-map]").forEach((root) => {
    const field = root.querySelector<HTMLElement>("[data-map]")!;
    const svg = root.querySelector<SVGSVGElement>("[data-map-lines]")!;
    const edges = (root.dataset.edges ?? "").split(",").filter(Boolean);
    const explorer = explore(root);

    // Orthogonal connectors between group boxes, with a small port at each end.
    // Elements are created once and only their geometry is updated, so a
    // redraw (resize, caption swap) never resets a lit line's state.
    const shapes = new Map<
      string,
      { g: SVGGElement; path: SVGPathElement; ports: SVGRectElement[] }
    >();
    const shape = (edge: string) => {
      let found = shapes.get(edge);
      if (!found) {
        const g = document.createElementNS(SVG, "g") as SVGGElement;
        g.setAttribute("data-edge", edge);
        const path = document.createElementNS(SVG, "path") as SVGPathElement;
        path.setAttribute("pathLength", "1");
        const ports = [0, 1].map(() => {
          const port = document.createElementNS(SVG, "rect") as SVGRectElement;
          port.setAttribute("width", "5");
          port.setAttribute("height", "5");
          return port;
        });
        g.append(path, ...ports);
        svg.append(g);
        found = { g, path, ports };
        shapes.set(edge, found);
      }
      return found;
    };

    const draw = () => {
      if (!desktop.matches) return;
      const f = field.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${f.width} ${f.height}`);
      // Snap to pixel centres so 1px strokes stay crisp. The browser paints the
      // SVG from a whole-pixel origin, so snap relative to that.
      const snapX = (v: number) => Math.round(v + f.left - Math.round(f.left)) + 0.5;
      const snapY = (v: number) => Math.round(v + f.top - Math.round(f.top)) + 0.5;
      const box = (id: string) => {
        const r = root.querySelector(`[data-group-block="${id}"]`)!.getBoundingClientRect();
        const x = r.left - f.left;
        const y = r.top - f.top;
        return {
          l: x,
          r: x + r.width,
          t: y,
          b: y + r.height,
          cx: x + r.width / 2,
          cy: y + r.height / 2,
        };
      };
      const gap = 16;
      const route = (a: string, b: string): [number, number][] => {
        const A = box(a);
        const B = box(b);
        if (A.b + gap < B.t) {
          // B below A: straight down if they share a column, else down then across.
          if (Math.abs(A.cx - B.cx) < 2)
            return [
              [A.cx, A.b + gap],
              [A.cx, B.t - gap],
            ];
          return [
            [A.cx, A.b + gap],
            [A.cx, B.cy],
            [B.cx < A.cx ? B.r + gap : B.l - gap, B.cy],
          ];
        }
        if (B.b + gap < A.t) return route(b, a);
        // Side by side: straight across between the facing edges.
        const [left, right] = A.cx < B.cx ? [A, B] : [B, A];
        const y = (Math.max(left.t, right.t) + Math.min(left.b, right.b)) / 2;
        return [
          [left.r + gap, y],
          [right.l - gap, y],
        ];
      };

      for (const edge of edges) {
        const [a, b] = edge.split(" ");
        const points = route(a, b).map(([x, y]) => [snapX(x), snapY(y)] as const);
        const { path, ports } = shape(edge);
        path.setAttribute("d", points.map(([x, y], i) => `${i ? "L" : "M"}${x},${y}`).join(" "));
        [points[0], points[points.length - 1]].forEach(([x, y], i) => {
          ports[i].setAttribute("x", String(x - 2.5));
          ports[i].setAttribute("y", String(y - 2.5));
        });
      }
      explorer.refresh();
    };

    new ResizeObserver(draw).observe(field);
    desktop.addEventListener("change", draw);
    document.fonts?.ready.then(draw);
  });
</script>

<style is:global>
  /* Global but namespaced under .map: the lines are created by script. */
  .map {
    --map-line: color-mix(in srgb, var(--color-fg) 36%, transparent);
    --t: var(--dur-base) var(--ease-out-expo);
  }

  /* Key ---------------------------------------------------------------- */
  .map__key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
  }

  .map__key-node {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-fg);
    font: inherit;
    font-size: var(--text-small);
    font-weight: 500;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .map__key-label {
    position: relative;
    padding-block: 0.3125rem;
  }

  .map__key-label::after,
  .map .tool__name::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background-color: var(--color-signature);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t);
  }

  .map__key-node.is-active .map__key-label::after {
    transform: scaleX(1);
  }

  .map__key-note {
    font-size: var(--text-small);
    color: var(--color-fg-muted);
  }

  .map__square,
  .map .tool__mark {
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    background-color: var(--color-signature);
  }

  /* Field (phones/tablets: a tree) ------------------------------------- */
  .map__field {
    position: relative;
    margin-top: 3rem;
  }

  .map__lines {
    display: none;
  }

  .map .group {
    position: relative;
  }

  .map .group__name {
    color: var(--color-mark);
    transition: color var(--t);
  }

  .map .group__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 1.375rem;
    margin-top: 0.75rem;
  }

  .map .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-fg);
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--t);
  }

  .map .tool__name {
    position: relative;
    font-size: clamp(1.25rem, 1.12rem + 0.45vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .map .group--core .tool__name {
    font-size: clamp(1.5rem, 1.15rem + 1.3vw, 2.25rem);
  }

  .map .group__caption {
    margin-top: 0.75rem;
    max-width: 34ch;
    min-height: calc(2 * var(--text-small--line-height) * 1em);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    color: var(--color-fg-muted);
  }

  .map .group__caption.is-swapping {
    animation: enter-rise var(--dur-fast) var(--ease-out-expo);
  }

  /* The core: framed by two corner marks, like a drawing's registration. */
  .map .group--core {
    padding: 1.25rem 1.5rem 1.25rem;
  }

  .map .group--core::before,
  .map .group--core::after {
    content: "";
    position: absolute;
    width: 1rem;
    height: 1rem;
    border: 0 solid var(--map-line);
    transition: border-color var(--t);
  }

  .map .group--core::before {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .map .group--core::after {
    right: 0;
    bottom: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  /* Branches: one spine down the left, a tick into each group. */
  .map__branches-start {
    width: 1px;
    height: 2rem;
    margin-left: 0.5rem;
    background-color: var(--map-line);
  }

  .map .group:not(.group--core) {
    margin-left: 0.5rem;
    padding: 0 0 2.5rem 1.75rem;
  }

  .map .group:not(.group--core)::before,
  .map .group:not(.group--core)::after {
    content: "";
    position: absolute;
    left: 0;
    background-color: var(--map-line);
    transition: background-color var(--t);
  }

  /* Spine segment */
  .map .group:not(.group--core)::before {
    top: 0;
    bottom: 0;
    width: 1px;
  }

  .map .group:last-child::before {
    bottom: auto;
    height: 0.5rem;
  }

  /* Tick, level with the group name */
  .map .group:not(.group--core)::after {
    top: 0.5rem;
    width: 1.25rem;
    height: 1px;
  }

  .map .group:last-child {
    padding-bottom: 0;
  }

  /* States ------------------------------------------------------------- */
  .map.is-exploring .tool:not(.is-active):not(.is-linked) {
    color: var(--color-fg-muted);
  }

  .map .tool.is-active .tool__name::after {
    transform: scaleX(1);
  }

  .map.is-exploring .group:not(.is-involved) .group__name {
    color: var(--color-fg-muted);
  }

  .map .group.is-involved .group__name {
    color: var(--color-fg);
  }

  .map.is-exploring .group.is-involved:not(.group--core)::after,
  .map.is-exploring .group--core.is-involved::before,
  .map.is-exploring .group--core.is-involved::after {
    background-color: var(--color-signature);
    border-color: var(--color-signature);
  }

  .map.is-exploring .group--core.is-involved::before,
  .map.is-exploring .group--core.is-involved::after {
    background-color: transparent;
  }

  .map {
    grid-column: content;
  }

  /* The key lines up with the section's text column (col 4). */
  @media (min-width: 64rem) {
    .map {
      display: grid;
      grid-template-columns: subgrid;
    }

    .map__key,
    .map__field {
      grid-column: col-start 4 / content-end;
    }
  }

  /* Wide screens: the 3×3 field ----------------------------------------- */
  @media (min-width: 80rem) {
    .map__field {
      grid-column: content;
      grid-column: content;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas:
        ". frontend ."
        "cloud backend data"
        ". ai .";
      column-gap: var(--col-gap);
      row-gap: clamp(4rem, 1rem + 5vw, 6.5rem);
      margin-top: 4.5rem;
    }

    .map__lines {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }

    .map__lines path {
      fill: none;
      stroke: var(--map-line);
      stroke-width: 1;
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
      transition:
        stroke var(--t),
        stroke-dashoffset 1400ms var(--ease-out-expo);
    }

    .map__lines rect {
      fill: var(--map-line);
      transition: fill var(--t);
    }

    .js .map__field:not(.is-revealed) .map__lines path {
      stroke-dashoffset: 1;
    }

    .map__lines .is-lit path {
      stroke: var(--color-signature);
    }

    .map__lines .is-lit rect {
      fill: var(--color-signature);
    }

    .map__branches-start {
      display: none;
    }

    .map .group {
      width: fit-content;
      max-width: 100%;
    }

    .map .group:not(.group--core) {
      margin: 0;
      padding: 0;
    }

    .map .group:not(.group--core)::before,
    .map .group:not(.group--core)::after {
      content: none;
    }

    .map .group--frontend {
      grid-area: frontend;
      justify-self: center;
      align-self: end;
    }

    .map .group--backend {
      grid-area: backend;
      justify-self: center;
      align-self: center;
      max-width: 26rem;
    }

    .map .group--cloud {
      grid-area: cloud;
      justify-self: start;
      align-self: center;
    }

    .map .group--data {
      grid-area: data;
      justify-self: end;
      align-self: center;
    }

    .map .group--ai {
      grid-area: ai;
      justify-self: center;
      align-self: start;
    }

    .map .group:not(.group--core) {
      max-width: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .map__field:not(.is-revealed) .map__lines path {
      stroke-dashoffset: 0;
    }
  }
</style>
