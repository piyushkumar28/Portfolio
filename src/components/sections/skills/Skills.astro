---
/**
 * Skills & Learning, on ink: a map of how the tools fit together rather than
 * a list of them (see SkillMap). No levels or percentages. Tools used in the
 * current role carry the copper square, derived from the experience
 * collection so the two sections can never disagree.
 */
import { getCollection } from "astro:content";
import Section from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import SkillMap from "./SkillMap.astro";

const roles = await getCollection("experience");
const currentTools = new Set(
  roles.filter((entry) => entry.data.end === null).flatMap((entry) => entry.data.tools),
);
---

<Section id="skills" labelledBy="skills-title" tone="ink">
  <div class="skills grid-editorial">
    <SectionHeader label="Skills & Learning" titleId="skills-title">
      How the pieces fit.
    </SectionHeader>

    <p class="skills__lede text-lead" data-reveal>
      Backend sits at the centre. Each line marks a place where two areas actually meet.
    </p>

    <div class="skills__map" data-reveal style="--delay: 90ms">
      <SkillMap currentTools={currentTools} />
    </div>
  </div>
</Section>

<style>
  .skills__lede {
    margin-top: 1.75rem;
    max-width: 44ch;
    color: var(--color-fg-muted);
  }

  .skills__map {
    display: grid;
    grid-template-columns: subgrid;
    margin-top: 2rem;
  }

  @media (min-width: 64rem) {
    .skills__lede {
      grid-column: col-start 4 / content-end;
    }
  }
</style>
