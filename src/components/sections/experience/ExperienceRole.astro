---
/**
 * One role as a product card: company mark, title and a live "Present"
 * badge; the one-sentence summary; four lenses on the work; the role's
 * system map; and the stack as chips.
 *
 * The card is the map's interaction scope ([data-system-scope]): the lenses
 * and chips are explorable nodes too, so hovering, focusing or tapping one
 * lights the matching part of the map and fills its readout (explore.ts).
 */
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/ui/Icon.astro";
import { skillGroups } from "@/data/skills";
import SystemMap from "./SystemMap.astro";

interface Props {
  entry: CollectionEntry<"experience">;
}

const { entry } = Astro.props;
const role = entry.data;
const isCurrent = role.end === null;

// What the work is, each tied to the parts of the map it touches.
const lenses = [
  {
    id: "lens-backend",
    title: "Backend features",
    text: "Models, business logic and views, written in Python and Django.",
    members: ["django", "python"],
  },
  {
    id: "lens-apis",
    title: "APIs & integrations",
    text: "REST endpoints for the interface and for other systems.",
    members: ["rest", "react", "systems"],
  },
  {
    id: "lens-data",
    title: "Data",
    text: "Relational data in PostgreSQL, through the ORM and plain SQL.",
    members: ["postgres", "django"],
  },
  {
    id: "lens-runtime",
    title: "Runtime & interface",
    text: "Docker for a consistent runtime; React where a feature needs an interface.",
    members: ["docker", "react"],
  },
];

// Stack chips map onto map components where one exists.
const nodeFor: Record<string, string> = {
  Python: "python",
  Django: "django",
  "REST APIs": "rest",
  SQL: "postgres",
  PostgreSQL: "postgres",
  Docker: "docker",
  React: "react",
};
const textOf = new Map(skillGroups.flatMap((g) => g.tools.map((t) => [t.name, t.text])));
const iconId = (tool: string) => tool.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const initials = role.company
  .split(" ")
  .slice(0, 2)
  .map((w) => w[0])
  .join("");
---

<article class="role spot" data-spotlight data-system-scope aria-labelledby="role-title">
  <header class="role__head">
    <span class="role__logo mono" aria-hidden="true">
      {initials}
    </span>
    <div class="role__id">
      <h3 id="role-title" class="role__title">
        {role.role}
      </h3>
      <p class="role__company">{role.company}</p>
    </div>
    <p class="role__period">
      {isCurrent && <span class="role__live" aria-hidden="true" />}
      <span class="mono">
        {role.start} — {isCurrent ? "Present" : role.end}
      </span>
    </p>
  </header>

  <p class="role__summary">{role.summary}</p>

  <div class="role__body">
    <ul class="role__lenses" role="list" aria-label="What I work on" data-roving>
      {role.system &&
        lenses.map((lens, i) => (
          <li>
            <button
              type="button"
              class="role__lens"
              data-node={lens.id}
              data-members={lens.members.join(" ")}
              data-links=""
              data-title={lens.title}
              data-kind="Focus"
              data-text={lens.text}
              aria-pressed="false"
            >
              <span class="role__lens-num mono" aria-hidden="true">
                0{i + 1}
              </span>
              <span class="role__lens-body">
                <span class="role__lens-title">{lens.title}</span>
                <span class="role__lens-text">{lens.text}</span>
              </span>
            </button>
          </li>
        ))}
    </ul>

    <div class="role__map">
      <SystemMap system={role.system} />
    </div>
  </div>

  <footer class="role__stack">
    <p class="role__stack-label mono">Stack</p>
    <ul class="role__chips" role="list" data-stagger data-roving>
      {role.tools.map((tool) => (
        <li>
          <button
            type="button"
            class="chip role__chip"
            data-node={`chip-${iconId(tool)}`}
            data-members={nodeFor[tool] ?? ""}
            data-links=""
            data-title={tool}
            data-kind="Stack"
            data-text={textOf.get(tool) ?? ""}
            aria-pressed="false"
          >
            <Icon id={iconId(tool)} />
            {tool}
          </button>
        </li>
      ))}
    </ul>
  </footer>
</article>

<style>
  .role {
    padding: clamp(1.25rem, 0.8rem + 1.8vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
  }

  .role__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem 1.125rem;
  }

  .role__logo {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-md);
    background: linear-gradient(145deg, var(--color-accent), var(--color-copper-deep));
    color: var(--color-ink-900);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .role__title {
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    font-weight: 600;
  }

  .role__company {
    margin-top: 0.25rem;
    color: var(--color-fg-muted);
    font-weight: 500;
  }

  .role__period {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid rgb(211 148 98 / 0.35);
    border-radius: var(--radius-full);
    background-color: rgb(211 148 98 / 0.07);
    color: var(--color-fg);
    font-size: 0.8125rem;
  }

  .role__live {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    animation: pulse-ring 2.4s var(--ease-out-expo) infinite;
  }

  .role__summary {
    max-width: 60ch;
    margin-top: 1.5rem;
    color: var(--color-fg-muted);
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .role__body {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  /* Lenses */
  .role__lenses {
    display: grid;
    gap: 0.5rem;
  }

  .role__lens {
    display: flex;
    gap: 1rem;
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--dur-fast),
      background-color var(--dur-fast),
      transform var(--dur-base) var(--ease-out-expo);
    -webkit-tap-highlight-color: transparent;
  }

  .role__lens:hover,
  .role__lens.is-active {
    border-color: rgb(211 148 98 / 0.5);
    background-color: rgb(211 148 98 / 0.05);
    transform: translateY(-2px);
  }

  .role__lens-num {
    padding-top: 0.125rem;
    color: var(--color-fg-subtle);
    transition: color var(--dur-fast);
  }

  .role__lens.is-active .role__lens-num {
    color: var(--color-accent);
  }

  .role__lens-body {
    display: grid;
    gap: 0.25rem;
  }

  .role__lens-title {
    font-weight: 600;
  }

  .role__lens-text {
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Stack */
  .role__stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .role__stack-label {
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.6875rem;
  }

  .role__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .role__chip {
    cursor: pointer;
    transition:
      border-color var(--dur-fast),
      background-color var(--dur-fast),
      transform var(--dur-base) var(--ease-spring);
  }

  .role__chip:hover,
  .role__chip.is-active {
    border-color: rgb(211 148 98 / 0.6);
    background-color: rgb(211 148 98 / 0.08);
    transform: translateY(-2px);
  }

  @media (min-width: 48rem) {
    .role__head {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .role__period {
      grid-column: auto;
    }
  }

  @media (min-width: 48rem) {
    .role__lenses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .role__lenses {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .role__lens {
      height: 100%;
    }
  }
</style>
