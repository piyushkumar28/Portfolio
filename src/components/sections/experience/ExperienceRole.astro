---
/**
 * One role: the start year as a large numeral in the index column (copper
 * square when current — the site's mark for "now"), the company and a short
 * summary, then the stack the work runs through (StackPath).
 * Must be a direct child of a `.grid-editorial` container; the role title is
 * the section heading (see Experience.astro).
 */
import type { CollectionEntry } from "astro:content";
import StackPath from "./StackPath.astro";

interface Props {
  entry: CollectionEntry<"experience">;
}

const { entry } = Astro.props;
const role = entry.data;
const isCurrent = role.end === null;
---

<div class="role">
  <p class="role__when" data-reveal>
    <span class="role__start font-display">{role.start}</span>
    <span class="role__until label">
      {isCurrent && <span class="role__now" aria-hidden="true" />}
      <span class="sr-only">to</span>
      {isCurrent ? "Present" : role.end}
    </span>
  </p>

  <div class="role__meta" data-reveal style="--delay: 80ms">
    <p class="role__company">{role.company}</p>
    <p class="role__summary text-lead">{role.summary}</p>
  </div>

  <div class="role__stack" data-reveal style="--delay: 160ms">
    <StackPath stack={role.stack} />
  </div>
</div>

<style>
  .role {
    display: grid;
    grid-column: content;
    grid-template-columns: subgrid;
  }

  .role__when,
  .role__meta,
  .role__stack {
    grid-column: content;
  }

  .role__when {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .role__start {
    font-size: clamp(3.5rem, 2rem + 5vw, 7.5rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .role__until {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-fg-muted);
  }

  .role__now {
    width: 0.4375rem;
    height: 0.4375rem;
    background-color: var(--color-signature);
  }

  .role__meta {
    margin-top: 1.75rem;
  }

  .role__company {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    font-weight: 500;
  }

  .role__summary {
    margin-top: 0.75rem;
    max-width: 58ch;
    color: var(--color-fg-muted);
  }

  .role__stack {
    margin-top: clamp(3.5rem, 2rem + 4vw, 6rem);
  }

  @media (min-width: 64rem) {
    .role__when {
      grid-column: col-start 1 / span 3;
      flex-direction: column;
      gap: 1rem;
    }

    .role__meta {
      grid-column: col-start 4 / span 7;
      margin-top: 0;
      padding-top: 0.5rem;
    }
  }
</style>
