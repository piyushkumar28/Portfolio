---
/**
 * One layer of the StackPath diagram, plus the hand-off to the next layer.
 * Styled by StackPath (global within `.stack`).
 */
interface Layer {
  id: string;
  tier: string;
  name: string;
  detail: string;
  text: string;
  handoff?: string;
}

interface Props {
  layer: Layer;
  number?: string;
  links: string[];
  next?: Layer;
}

const { layer, number, links, next } = Astro.props;
---

<div class="layer" role="listitem">
  <span class="layer__tier label" aria-hidden="true">
    {number ? `${number} · ${layer.tier}` : layer.tier}
  </span>
  <button
    type="button"
    class="layer__node"
    data-node={layer.id}
    data-group="stack"
    data-title={`${layer.name} · ${layer.detail}`}
    data-links={links.join(" ")}
    data-text={layer.text}
    aria-describedby={`stack-${layer.id}`}
    aria-pressed="false"
  >
    <span class="layer__name font-display">{layer.name}</span>
    <span class="layer__detail">{layer.detail}</span>
  </button>
  <span id={`stack-${layer.id}`} class="sr-only">
    {layer.tier}. {layer.text}
  </span>
</div>
{layer.handoff && next && (
  <span class="handoff" data-edge={`${layer.id} ${next.id}`} aria-hidden="true">
    <span class="handoff__label">{layer.handoff}</span>
    <span class="handoff__line" />
  </span>
)}
