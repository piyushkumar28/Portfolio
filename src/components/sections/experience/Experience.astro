---
import { getCollection } from "astro:content";
import Section from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import ExperienceRole from "./ExperienceRole.astro";

// One role so far: its title is the section heading. With more roles, the
// heading becomes a section title and each role renders its own.
const [current] = (await getCollection("experience")).sort((a, b) => b.data.start - a.data.start);
---

<Section id="experience" labelledBy="experience-title">
  <div class="experience grid-editorial">
    <SectionHeader label="Experience" titleId="experience-title">
      {current.data.role}
    </SectionHeader>

    <div class="experience__role">
      <ExperienceRole entry={current} />
    </div>
  </div>
</Section>

<style>
  .experience__role {
    display: grid;
    grid-template-columns: subgrid;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
</style>
