---
import { getCollection } from "astro:content";
import Section from "@/components/layout/Section.astro";
import SectionHead from "@/components/layout/SectionHead.astro";
import ExperienceRole from "./ExperienceRole.astro";

const roles = (await getCollection("experience")).sort((a, b) => b.data.start - a.data.start);
---

<Section id="experience" labelledBy="experience-title">
  <SectionHead index="02" label="Experience" titleId="experience-title">
    Where I’m <span class="accent-word">building</span> now.
    <Fragment slot="intro">
      The backend I work on, and how its pieces connect. Hover a part of the work, or trace a
      request through it.
    </Fragment>
  </SectionHead>

  <div class="experience__roles" data-reveal>
    {roles.map((entry) => (
      <ExperienceRole entry={entry} />
    ))}
  </div>
</Section>

<style>
  .experience__roles {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
</style>
