---
/**
 * One row of the About index: number, serif title and a short description,
 * set between hairline rules. Must be placed in a subgrid of the editorial grid.
 *
 * `.is-active` (set by About's script — on hover, or as the row crosses the
 * middle of the screen while reading) draws a copper line over the rule, turns
 * the number copper, extends a short marker towards the title, steps the title
 * forward and brings the description up to full contrast.
 */
interface Props {
  index: number;
  title: string;
}

const { index, title } = Astro.props;
const number = String(index).padStart(2, "0");
const delay = `${(index - 1) * 90}ms`;
---

<li class="pillar" data-reveal data-principle style={`--delay: ${delay}`}>
  <span class="pillar__accent" aria-hidden="true"></span>
  <span class="pillar__index label" aria-hidden="true">
    <span class="pillar__num">{number}</span>
    <span class="pillar__marker"></span>
  </span>
  <h3 class="pillar__title font-display text-heading">{title}</h3>
  <p class="pillar__text">
    <slot />
  </p>
</li>

<style>
  .pillar {
    --t: var(--dur-slow) var(--ease-out-expo);
    position: relative;
    display: grid;
    grid-column: content;
    grid-template-columns: subgrid;
    align-items: baseline;
    row-gap: 0.875rem;
    padding-block: 1.75rem 2.25rem;
  }

  /* Resting rule — draws in from the left as the row is revealed. */
  .pillar::before,
  .pillar__accent {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    transform-origin: left center;
  }

  .pillar::before {
    background-color: var(--color-rule);
    transition: transform 1100ms var(--ease-out-expo);
    transition-delay: calc(var(--delay) + 120ms);
  }

  :global(.js) .pillar:not(.is-revealed)::before {
    transform: scaleX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .pillar:not(.is-revealed)::before {
      transform: none;
    }
  }

  /* Active line: arrives from the left, leaves to the right. */
  .pillar__accent {
    background-color: var(--color-signature);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--t);
  }

  .pillar__index {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    grid-column: col-start 1;
    grid-row: 1;
    color: var(--color-mark);
  }

  .pillar__num {
    transition: color var(--t);
  }

  .pillar__marker {
    width: 0.875rem;
    height: 1px;
    background-color: var(--color-signature);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t);
  }

  .pillar__title {
    grid-column: col-start 2 / content-end;
    grid-row: 1;
    transition: transform var(--t);
  }

  .pillar__text {
    grid-column: col-start 2 / content-end;
    grid-row: 2;
    max-width: 44ch;
    color: var(--color-fg-muted);
    transition: color var(--t);
  }

  /* Active ------------------------------------------------------------ */
  .pillar.is-active .pillar__accent {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .pillar.is-active .pillar__num {
    color: var(--color-signature);
  }

  .pillar.is-active .pillar__marker {
    transform: scaleX(1);
  }

  .pillar.is-active .pillar__title {
    transform: translateX(0.375rem);
  }

  .pillar.is-active .pillar__text {
    color: var(--color-fg);
  }

  @media (min-width: 48rem) {
    .pillar {
      padding-block: 2.25rem 2.75rem;
    }

    .pillar__index {
      grid-column: col-start 1 / span 2;
    }

    .pillar__marker {
      width: 1.75rem;
    }

    .pillar__title {
      grid-column: col-start 3 / content-end;
    }

    .pillar__text {
      grid-column: col-start 3 / span 8;
    }
  }

  @media (min-width: 64rem) {
    .pillar {
      padding-block: 2.5rem 3rem;
    }

    .pillar__index {
      grid-column: col-start 1 / span 3;
    }

    .pillar__marker {
      width: 2.5rem;
    }

    .pillar__title {
      grid-column: col-start 4 / span 4;
    }

    .pillar.is-active .pillar__title {
      transform: translateX(0.625rem);
    }

    .pillar__text {
      grid-column: col-start 8 / content-end;
      grid-row: 1;
    }
  }
</style>
