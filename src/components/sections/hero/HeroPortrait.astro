---
import { Picture } from "astro:assets";
import portrait from "@/assets/images/portrait/portrait.jpg";

/**
 * The portrait is shown unedited. Its studio-white background is blended into the
 * page with `multiply`: white takes on the paper tone, everything else is
 * effectively unchanged. It must therefore only ever sit on paper.
 *
 * Motion — the band below is its floor:
 *  - entrance: it rises out of the band (clip from the bottom + a short lift),
 *    once fonts are ready and the figure is on screen;
 *  - scroll: over the first screen it sinks ~9% behind the band, a slower
 *    drift than the page (CSS scroll timeline; skipped where unsupported or
 *    when reduced motion is requested).
 *
 * Both wrappers paint the page colour themselves: the figure and the <picture>
 * become isolated stacking contexts while animating (and the scroll timeline
 * keeps <picture> transformed), so the multiply must always have paper directly
 * behind it — otherwise the white background would show as a box.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"figure">;

const { class: className, ...rest } = Astro.props;
---

<figure class:list={["portrait", className]} data-inview {...rest}>
  <Picture
    src={portrait}
    formats={["avif", "webp"]}
    widths={[400, 600, 800, 1050]}
    sizes="(min-width: 64rem) min(34vw, 523px), (min-width: 48rem) 42vw, min(84vw, 480px)"
    alt="Portrait of Piyush Kumar"
    priority
    class="portrait__img"
    data-enter="emerge"
    style="--delay: 300ms"
  />
</figure>

<style>
  .portrait {
    margin: 0;
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .portrait :global(picture) {
    display: block;
    background-color: var(--color-bg);
  }

  .portrait__img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }

  /* Off-screen on load (phones): hold the entrance until it is in view. */
  :global(.js) .portrait:not(.is-revealed) .portrait__img {
    animation-play-state: paused;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhands on purpose: `animation-timeline` is reset-only in the
         shorthand, and a minifier must not fold it back into one. */
      .portrait :global(picture) {
        animation-name: portrait-sink;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes portrait-sink {
    to {
      transform: translate3d(0, 9%, 0);
    }
  }
</style>
