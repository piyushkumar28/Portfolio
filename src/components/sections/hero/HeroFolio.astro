---
/**
 * The hero's closing band: availability on the left, the scroll cue on the
 * right. It is the first strip of ink — the portrait stands on its top edge and
 * the About section continues the same tone below it.
 * Place it on the editorial grid spanning `full` (edge to edge).
 */
import type { HTMLAttributes } from "astro/types";
import ArrowSwap from "@/components/ui/ArrowSwap.astro";
import { site } from "@/data/site";

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div class:list={["folio", className]} data-tone="ink" {...rest}>
  <div class="folio__availability" data-enter="rise" style="--delay: 760ms">
    <span class="folio__mark" aria-hidden="true"></span>
    <ul role="list" class="folio__list">
      {site.availability.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>

  <a
    href="#about"
    class="folio__scroll label swap-trigger"
    data-enter="rise"
    style="--delay: 840ms"
  >
    Scroll to explore
    <ArrowSwap direction="down" class="folio__arrow" />
  </a>
</div>

<style>
  /* Subgrid: the band runs edge to edge while its text stays on the content
     columns. The band itself never animates, so its edge is always crisp. */
  .folio {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 1rem;
    padding-top: 1.375rem;
  }

  /* Closing hairline: ends the hero inside the ink that continues below. */
  .folio::after {
    content: "";
    grid-column: content;
    height: 1px;
    margin-top: 0.5rem;
    background-color: var(--color-rule);
    transform-origin: left center;
  }

  :global(.js) .folio::after {
    animation: enter-draw 1200ms var(--ease-out-expo) 800ms both paused;
  }

  :global(.js.is-ready) .folio::after {
    animation-play-state: running;
  }

  .folio__availability {
    grid-column: content;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  /* Signature: the one copper mark in the band. */
  .folio__mark {
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    background-color: var(--color-signature);
    transform: translateY(-0.0625rem);
  }

  .folio__list {
    display: flex;
    flex-direction: column;
  }

  .folio__scroll {
    display: none;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fg-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-editorial);
  }

  .folio__scroll:hover,
  .folio__scroll:focus-visible {
    color: var(--color-fg);
  }

  .folio__scroll :global(.folio__arrow) {
    font-size: 0.875rem;
  }

  /* Once the hero has settled, the arrow makes a single downward pass. */
  :global(.js.is-ready) .folio__scroll :global(.swap__track) {
    animation: folio-nudge 1100ms var(--ease-out-expo) 2400ms 1;
  }

  @keyframes folio-nudge {
    0% {
      transform: none;
    }
    99.9% {
      transform: translateY(110%);
    }
    100% {
      transform: none;
    }
  }

  @media (min-width: 48rem) {
    .folio {
      align-items: center;
    }

    .folio__availability {
      grid-row: 1;
      justify-self: start;
    }

    .folio__list {
      flex-direction: row;
    }

    .folio__list li + li::before {
      content: "·" / "";
      margin-inline: 0.625rem;
      color: var(--color-fg-muted);
    }

    .folio__scroll {
      display: inline-flex;
      grid-column: content;
      grid-row: 1;
      justify-self: end;
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .folio::after,
    :global(.js.is-ready) .folio__scroll :global(.swap__track) {
      animation: none;
    }
  }
</style>
