---
/**
 * Section opener on the editorial grid: a small label in the index column
 * (columns 1–3) and the serif title from column 4. Must be a direct child of a
 * `.grid-editorial` container. The title is a slot so each section controls its
 * own line breaks.
 */
interface Props {
  label: string;
  titleId: string;
}

const { label, titleId } = Astro.props;
---

<div class="section-header">
  <p class="section-header__label label" data-reveal>
    <span class="section-header__rule" aria-hidden="true"></span>
    {label}
  </p>
  <h2 id={titleId} class="section-header__title font-display text-title" data-reveal>
    <slot />
  </h2>
</div>

<style>
  .section-header {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 2rem;
    align-items: start;
  }

  .section-header__label {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    grid-column: content;
    color: var(--color-mark);
  }

  .section-header__rule {
    width: 2rem;
    height: 1px;
    background-color: currentColor;
  }

  .section-header__title {
    grid-column: content;
  }

  @media (min-width: 64rem) {
    .section-header__label {
      grid-column: col-start 1 / span 3;
      padding-top: 1.1em;
    }

    .section-header__title {
      grid-column: col-start 4 / content-end;
    }
  }
</style>
