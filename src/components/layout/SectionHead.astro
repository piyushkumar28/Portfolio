---
/**
 * Section opener: a mono index kicker ("02 — Experience"), the title (slot;
 * wrap one word in .accent-word for the serif accent) and an optional intro
 * (slot "intro"), which sits beside the title on wide screens.
 */
interface Props {
  index: string;
  label: string;
  titleId: string;
}

const { index, label, titleId } = Astro.props;
const hasIntro = Astro.slots.has("intro");
---

<div class:list={["head", { "head--split": hasIntro }]}>
  <div class="head__main">
    <p class="head__kicker mono" data-reveal>
      <span class="head__index">{index}</span>
      <span class="head__rule" aria-hidden="true"></span>
      <span>{label}</span>
    </p>
    <h2 id={titleId} class="head__title" data-reveal style="--delay: 60ms">
      <slot />
    </h2>
  </div>
  {hasIntro && (
    <p class="head__intro" data-reveal style="--delay: 120ms">
      <slot name="intro" />
    </p>
  )}
</div>

<style>
  .head {
    display: grid;
    gap: 1.5rem 3rem;
  }

  .head__kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.6875rem;
  }

  .head__index {
    color: var(--color-accent);
  }

  .head__rule {
    width: 2rem;
    height: 1px;
    background-color: var(--color-line-strong);
  }

  .head__title {
    margin-top: 1.25rem;
    max-width: 20ch;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: var(--text-title--letter-spacing);
    font-weight: 600;
  }

  .head__intro {
    max-width: 40ch;
    color: var(--color-fg-muted);
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  @media (min-width: 64rem) {
    .head--split {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: end;
    }

    .head__intro {
      justify-self: end;
      padding-bottom: 0.5rem;
    }
  }
</style>
