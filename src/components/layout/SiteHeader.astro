---
import Button from "@/components/ui/Button.astro";
import { contactHref, nav, site } from "@/data/site";
---

<header class="site-header grid-editorial" data-tone="ink">
  <div class="site-header__inner">
    <a href="/" class="site-header__name" aria-label={`${site.name} — home`}>
      {site.name}
    </a>

    <nav aria-label="Primary">
      <ul role="list" class="site-header__nav">
        {nav.map((item) => (
          <li>
            <Button href={item.href} variant="quiet">
              {item.label}
            </Button>
          </li>
        ))}
        <li>
          <Button href={contactHref} variant="quiet" arrow="up-right">
            Let’s Talk
          </Button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .site-header__name {
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    font-weight: 450;
    letter-spacing: -0.012em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 0.8rem + 1.6vw, 2.5rem);
  }
</style>
