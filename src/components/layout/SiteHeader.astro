---
/**
 * Floating navigation pill.
 *  - Tightens once the page scrolls; a copper line along its bottom edge
 *    tracks reading progress.
 *  - A path readout (~/projects) and a sliding indicator follow the section
 *    in view; the indicator also follows the pointer across the links.
 *  - On phones the links move into a modal <dialog> sheet (focus contained,
 *    Escape closes, the page behind is inert).
 */
import ArrowSwap from "@/components/ui/ArrowSwap.astro";
import { nav, site } from "@/data/site";
---

<header class="hdr" data-header>
  <div class="hdr__wrap">
    <div class="hdr__pill">
      <a href="#top" class="hdr__brand" aria-label={`${site.name} — back to top`}>
        <span class="hdr__mark" aria-hidden="true">
          PK
        </span>
        <span class="hdr__name">{site.name}</span>
      </a>
      <span class="hdr__path mono" aria-hidden="true">
        ~/<span data-path>home</span>
        <span class="hdr__caret"></span>
      </span>

      <nav class="hdr__nav" aria-label="Primary">
        <ul role="list" class="hdr__links" data-links>
          <li class="hdr__indicator" aria-hidden="true" data-indicator></li>
          {nav
            .filter((item) => item.href !== "#contact")
            .map((item) => (
              <li>
                <a href={item.href} class="hdr__link" data-link={item.href.slice(1)}>
                  {item.label}
                </a>
              </li>
            ))}
        </ul>
      </nav>

      <a href="#contact" class="hdr__cta swap-trigger" data-link="contact">
        Let’s talk <ArrowSwap direction="up-right" />
      </a>

      <button
        type="button"
        class="hdr__menu"
        aria-haspopup="dialog"
        aria-controls="site-menu"
        data-menu-open
      >
        <span class="hdr__menu-lines" aria-hidden="true"></span>
        Menu
      </button>

      <span class="hdr__progress" aria-hidden="true">
        <span data-progress></span>
      </span>
    </div>
  </div>
</header>

<dialog id="site-menu" class="sheet" aria-label="Menu">
  <div class="sheet__head">
    <span class="hdr__brand">
      <span class="hdr__mark" aria-hidden="true">
        PK
      </span>
      <span class="hdr__name">{site.name}</span>
    </span>
    <button type="button" class="sheet__close" data-menu-close>
      Close
    </button>
  </div>
  <nav aria-label="Sections">
    <ul role="list" class="sheet__list">
      {nav.map((item, i) => (
        <li style={`--i: ${i}`}>
          <a href={item.href} class="sheet__link" data-menu-link>
            <span class="mono sheet__index">0{i + 1}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p class="sheet__foot mono">
    {site.role} · {site.focus}
  </p>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const progress = header.querySelector<HTMLElement>("[data-progress]")!;
  const path = header.querySelector<HTMLElement>("[data-path]")!;
  const list = header.querySelector<HTMLElement>("[data-links]")!;
  const indicator = header.querySelector<HTMLElement>("[data-indicator]")!;
  const links = [...header.querySelectorAll<HTMLAnchorElement>("[data-link]")];

  // Scroll state + progress ---------------------------------------------
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const max = document.documentElement.scrollHeight - innerHeight;
      header.classList.toggle("is-scrolled", scrollY > 24);
      progress.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
      ticking = false;
    });
  };
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Active section: path readout + indicator ----------------------------
  let active: string | null = null;
  const place = (link: HTMLElement | undefined) => {
    if (!link || !list.contains(link)) {
      indicator.style.opacity = "0";
      return;
    }
    indicator.style.opacity = "1";
    indicator.style.width = `${link.offsetWidth}px`;
    indicator.style.transform = `translateX(${link.offsetLeft}px)`;
  };
  const setActive = (id: string) => {
    active = id;
    path.textContent = id === "top" ? "home" : id;
    for (const link of links) {
      if (link.dataset.link === id) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
    place(links.find((l) => l.dataset.link === id));
  };

  const sections = ["top", ...links.map((l) => l.dataset.link!)]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));
  if ("IntersectionObserver" in window) {
    const seen = new Map<Element, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) seen.set(e.target, e.isIntersecting ? e.intersectionRatio : 0);
        const best = [...seen].sort((a, b) => b[1] - a[1])[0];
        if (best && best[1] > 0 && best[0].id !== active) setActive(best[0].id);
      },
      { rootMargin: "-35% 0px -55% 0px", threshold: [0, 0.01, 0.5, 1] },
    );
    sections.forEach((s) => io.observe(s));
  }

  for (const link of links) {
    link.addEventListener("pointerenter", () => place(link));
    link.addEventListener("focus", () => place(link));
  }
  list.addEventListener("pointerleave", () => place(links.find((l) => l.dataset.link === active)));
  addEventListener("resize", () => place(links.find((l) => l.dataset.link === active)));

  // Phone menu ------------------------------------------------------------
  const menu = document.querySelector<HTMLDialogElement>("#site-menu")!;
  const opener = header.querySelector<HTMLButtonElement>("[data-menu-open]")!;
  opener.addEventListener("click", () => {
    menu.showModal();
    opener.setAttribute("aria-expanded", "true");
  });
  menu.addEventListener("close", () => opener.setAttribute("aria-expanded", "false"));
  menu.querySelector("[data-menu-close]")!.addEventListener("click", () => menu.close());
  menu
    .querySelectorAll("[data-menu-link]")
    .forEach((a) => a.addEventListener("click", () => menu.close()));
  menu.addEventListener("click", (e) => e.target === menu && menu.close());
</script>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 0.875rem var(--gutter) 0;
    pointer-events: none;
    transition: padding var(--dur-base) var(--ease-out-expo);
  }

  .hdr.is-scrolled {
    padding-top: 0.5rem;
  }

  .hdr__wrap {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .hdr__pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.375rem 0.5rem 0.375rem 0.625rem;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    pointer-events: auto;
    transition:
      background-color var(--dur-base) var(--ease-out-expo),
      border-color var(--dur-base) var(--ease-out-expo),
      box-shadow var(--dur-base) var(--ease-out-expo);
  }

  .hdr.is-scrolled .hdr__pill {
    border-color: var(--color-line-strong);
    background-color: rgb(13 18 24 / 0.9);
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 12px 40px -18px rgb(0 0 0 / 0.7);
  }

  /* Brand */
  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding-right: 0.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .hdr__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgb(211 148 98 / 0.5);
    border-radius: var(--radius-sm);
    background: rgb(211 148 98 / 0.08);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);
  }

  .hdr__brand:hover .hdr__mark,
  .hdr__brand:focus-visible .hdr__mark {
    background-color: var(--color-accent);
    color: var(--color-ink-900);
  }

  .hdr__name {
    font-size: 0.9375rem;
  }

  .hdr__path {
    display: none;
    color: var(--color-fg-subtle);
  }

  .hdr__path [data-path] {
    color: var(--color-fg-muted);
  }

  .hdr__caret {
    display: inline-block;
    width: 0.45em;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background-color: var(--color-accent);
    animation: caret 1.1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* Links */
  .hdr__nav {
    display: none;
    margin-left: auto;
  }

  .hdr__links {
    position: relative;
    display: flex;
    align-items: center;
  }

  .hdr__indicator {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: var(--radius-full);
    background-color: rgb(243 239 231 / 0.07);
    opacity: 0;
    transition:
      transform var(--dur-base) var(--ease-out-expo),
      width var(--dur-base) var(--ease-out-expo),
      opacity var(--dur-fast);
  }

  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.9375rem;
    border-radius: var(--radius-full);
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color var(--dur-fast);
  }

  .hdr__link:hover,
  .hdr__link[aria-current] {
    color: var(--color-fg);
  }

  .hdr__cta {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1.125rem;
    border-radius: var(--radius-full);
    background-color: var(--color-action);
    color: var(--color-on-action);
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color var(--dur-fast);
  }

  .hdr__cta:hover,
  .hdr__cta:focus-visible {
    background-color: var(--color-accent);
  }

  .hdr__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    margin-left: auto;
    padding: 0 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    background-color: rgb(13 18 24 / 0.6);
    backdrop-filter: blur(10px);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .hdr__menu-lines {
    width: 0.875rem;
    height: 0.5rem;
    border-block: 1.5px solid currentColor;
  }

  .hdr__progress {
    position: absolute;
    inset: auto 1.75rem -1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--dur-base);
  }

  .hdr.is-scrolled .hdr__progress {
    opacity: 1;
  }

  .hdr__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--color-accent) 30%);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (min-width: 64rem) {
    .hdr__nav,
    .hdr__cta {
      display: flex;
    }

    .hdr__menu {
      display: none;
    }
  }

  @media (min-width: 72rem) {
    .hdr__path {
      display: inline;
    }
  }

  /* Phone sheet */
  .sheet {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0.875rem var(--gutter) 2rem;
    border: 0;
    background-color: var(--color-ink-950);
    color: var(--color-fg);
  }

  .sheet::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .sheet[open] {
    display: flex;
    flex-direction: column;
  }

  .sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    padding-inline: 0.625rem 0.5rem;
  }

  .sheet__close {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .sheet__list {
    display: grid;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .sheet__list li {
    border-bottom: 1px solid var(--color-line);
    animation: enter-rise var(--dur-slow) var(--ease-out-expo) both;
    animation-delay: calc(80ms + var(--i) * 50ms);
  }

  .sheet__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.125rem 0.25rem;
    font-size: clamp(1.75rem, 1.3rem + 2.5vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .sheet__index {
    color: var(--color-accent);
  }

  .sheet__foot {
    margin-top: auto;
    color: var(--color-fg-subtle);
  }
</style>
