---
/**
 * Page section shell: id + accessible name, vertical rhythm and a background
 * step ("base" or the slightly lifted "alt") so neighbouring sections read
 * as separate panels of the same product.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  id: string;
  labelledBy: string;
  surface?: "base" | "alt";
}

const { id, labelledBy, surface = "base", class: className, ...rest } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledBy}
  class:list={["section", `section--${surface}`, className]}
  {...rest}
>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    padding-block: var(--section-space);
  }

  .section--alt {
    background-color: var(--color-bg-alt);
    border-block: 1px solid var(--color-line);
  }
</style>
