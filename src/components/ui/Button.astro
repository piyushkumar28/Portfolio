---
/**
 * Link styled as a button.
 *  - primary:   ivory pill; a copper fill sweeps in from the pointer side on
 *               hover and the arrow swaps (ArrowSwap).
 *  - secondary: outlined pill that fills faintly on hover.
 *  - ghost:     text with an underline that draws in.
 * `magnetic` lets it drift toward the pointer (scripts/interact.ts).
 */
import type { HTMLAttributes } from "astro/types";
import ArrowSwap from "./ArrowSwap.astro";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  arrow?: "right" | "up-right" | "down" | false;
  magnetic?: boolean;
  size?: "md" | "sm";
}

const {
  href,
  variant = "primary",
  arrow = "right",
  magnetic = false,
  size = "md",
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={["btn", `btn--${variant}`, `btn--${size}`, "swap-trigger", className]}
  data-magnetic={magnetic ? "5" : undefined}
  {...rest}
>
  <span class="btn__fill" aria-hidden="true"></span>
  <span class="btn__label">
    <slot />
  </span>
  {arrow && <ArrowSwap direction={arrow} class="btn__arrow" />}
</a>

<style>
  .btn {
    --mag-x: 0px;
    --mag-y: 0px;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 3rem;
    padding: 0 1.375rem;
    overflow: hidden;
    border-radius: var(--radius-full);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    text-decoration: none;
    white-space: nowrap;
    transform: translate3d(var(--mag-x), var(--mag-y), 0);
    transition:
      transform var(--dur-base) var(--ease-out-expo),
      color var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast) var(--ease-out-expo),
      background-color var(--dur-fast) var(--ease-out-expo);
    -webkit-tap-highlight-color: transparent;
  }

  .btn--sm {
    min-height: 2.5rem;
    padding: 0 1.125rem;
    font-size: 0.875rem;
  }

  .btn__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .btn:hover .btn__fill,
  .btn:focus-visible .btn__fill {
    transform: scaleX(1);
  }

  .btn:active {
    transform: translate3d(var(--mag-x), var(--mag-y), 0) scale(0.98);
  }

  /* Primary */
  .btn--primary {
    background-color: var(--color-action);
    color: var(--color-on-action);
  }

  .btn--primary .btn__fill {
    background-color: var(--color-accent);
  }

  /* Secondary */
  .btn--secondary {
    border: 1px solid var(--color-line-strong);
    color: var(--color-fg);
  }

  .btn--secondary .btn__fill {
    background-color: rgb(243 239 231 / 0.07);
  }

  .btn--secondary:hover,
  .btn--secondary:focus-visible {
    border-color: rgb(243 239 231 / 0.4);
  }

  /* Ghost */
  .btn--ghost {
    min-height: 2.75rem;
    padding: 0;
    border-radius: 0;
    color: var(--color-fg);
  }

  .btn--ghost .btn__fill {
    display: none;
  }

  .btn--ghost .btn__label {
    background: linear-gradient(currentColor, currentColor) left calc(100% - 1px) / 0 1px no-repeat;
    transition: background-size var(--dur-base) var(--ease-out-expo);
  }

  .btn--ghost:hover .btn__label,
  .btn--ghost:focus-visible .btn__label {
    background-size: 100% 1px;
  }

  .btn__label {
    position: relative;
  }
</style>
