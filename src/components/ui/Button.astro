---
import ArrowSwap from "./ArrowSwap.astro";

/**
 * Link-styled actions. Every CTA on the site is navigation, so this always renders <a>.
 * Colours come from the section tone's action/accent tokens.
 *
 *  - primary: solid action fill. On hover/focus a second fill wipes in from the
 *             left (and leaves to the right), the label eases back a touch and
 *             the arrow is swapped.
 *  - text:    resting hairline underline; an accent line draws over it.
 *  - quiet:   no resting underline; the accent line draws on hover/focus (nav).
 *
 * Hover styles only apply on devices that hover; keyboard focus gets the same
 * treatment, and touch gets it while pressed.
 */
interface Props {
  href: string;
  variant?: "primary" | "text" | "quiet";
  arrow?: "right" | "up-right" | "down";
  class?: string;
  [key: string]: unknown;
}

const { href, variant = "primary", arrow, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={["btn", `btn--${variant}`, "swap-trigger", className]} {...rest}>
  {variant === "primary" && <span class="btn__fill" aria-hidden="true" />}
  <span class="btn__label">
    <slot />
  </span>
  {arrow && <ArrowSwap direction={arrow} class="btn__arrow" />}
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1;
    letter-spacing: 0.005em;
    white-space: nowrap;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .btn__label {
    position: relative;
    transition:
      transform var(--dur-base) var(--ease-out-expo),
      color var(--dur-fast) var(--ease-editorial);
  }

  /* Primary ---------------------------------------------------------- */
  .btn--primary {
    isolation: isolate;
    overflow: hidden;
    min-height: 3.375rem;
    padding-inline: 1.625rem 1.375rem;
    background-color: var(--color-action);
    color: var(--color-on-action);
    border-radius: var(--radius-sm);
    transition: transform 160ms var(--ease-editorial);
  }

  .btn__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-action-hover);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 620ms var(--ease-out-expo);
  }

  @media (hover: hover) {
    .btn--primary:hover .btn__fill {
      transform: scaleX(1);
      transform-origin: left center;
    }

    .btn--primary:hover .btn__label {
      transform: translateX(-0.125rem);
    }
  }

  .btn--primary:focus-visible .btn__fill,
  .btn--primary:active .btn__fill {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .btn--primary:active {
    transform: translateY(1px);
  }

  /* Text + quiet ------------------------------------------------------ */
  .btn--text,
  .btn--quiet {
    min-height: 2.75rem;
    color: var(--color-fg);
  }

  .btn--text .btn__label,
  .btn--quiet .btn__label {
    padding-block: 0.3125rem;
  }

  /* Resting hairline (text only) and the accent line that draws over it. */
  .btn--text .btn__label::before,
  .btn--text .btn__label::after,
  .btn--quiet .btn__label::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
  }

  .btn--text .btn__label::before {
    background-color: currentColor;
    opacity: 0.32;
  }

  .btn--text .btn__label::after,
  .btn--quiet .btn__label::after {
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  @media (hover: hover) {
    .btn--text:hover .btn__label::after,
    .btn--quiet:hover .btn__label::after {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  .btn--text:focus-visible .btn__label::after,
  .btn--quiet:focus-visible .btn__label::after,
  .btn--text:active .btn__label::after,
  .btn--quiet:active .btn__label::after {
    transform: scaleX(1);
    transform-origin: left center;
  }
</style>
